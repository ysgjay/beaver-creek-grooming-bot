{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "bcbot/**"
    }
  },
  "crons": [
    {
      "path": "/api/run",
      "schedule": "5 14 * * *"
    },
    {
      "path": "/api/observe",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/data/:path*"
    },
    {
      "source": "/maps/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/maps/:path*"
    },
    {
      "source": "/cams/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/cams/:path*"
    },
    {
      "source": "/radar/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/radar/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(app.js|appearance.js|report-ui.js|app.css|themes.css|frost.css|dark.css|manifest.webmanifest|config.json|resorts.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
