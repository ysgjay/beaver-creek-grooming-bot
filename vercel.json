{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "bcbot/**"
    }
  },
  "crons": [
    {
      "path": "/api/run",
      "schedule": "5 14 * * *"
    },
    {
      "path": "/api/observe",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/audit",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/facts",
      "schedule": "30 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/api/page?llms=1"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/page?feed=1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?sitemap=1"
    },
    {
      "source": "/resorts",
      "destination": "/api/page"
    },
    {
      "source": "/passes/:pass",
      "destination": "/api/page?pass=:pass"
    },
    {
      "source": "/resorts/:slug",
      "destination": "/api/page?resort=:slug"
    },
    {
      "source": "/resorts/:slug/feed.xml",
      "destination": "/api/page?resort=:slug&feed=1"
    },
    {
      "source": "/resorts/:slug/:date",
      "destination": "/api/page?resort=:slug&date=:date"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/stats",
      "destination": "/admin.html"
    },
    {
      "source": "/audit",
      "destination": "/audit.html"
    },
    {
      "source": "/audit/:slug",
      "destination": "/audit.html"
    },
    {
      "source": "/data/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/data/:path*"
    },
    {
      "source": "/maps/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/maps/:path*"
    },
    {
      "source": "/cams/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/cams/:path*"
    },
    {
      "source": "/radar/:path*",
      "destination": "https://kpkajfy5kovso7gy.public.blob.vercel-storage.com/radar/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(admin|stats|admin.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(app.js|appearance.js|report-ui.js|app.css|themes.css|frost.css|dark.css|frost-surfaces.css|manifest.webmanifest|config.json|resorts.json|audit.js|audit.css|admin.js|admin.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
